{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["db/**/*.ts", "netlify/**/*.mts", "netlify/lib/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
